// =============================================================================
// GLOBAL TIMING CONFIGURATION
// =============================================================================
// Adjust these values to tune your home row mods across the entire keyboard!

#define TAPPING_TERM_MS 200
#define PRIOR_IDLE_MS   150

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;      // 0
    time-to-max-speed-ms = <0>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

behaviors {
        /* Shared hold-tap logic triggered on the 2nd tap */
        hm_mod: home_row_mod_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            require-prior-idle-ms = <PRIOR_IDLE_MS>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* ================= LEFT HAND (GACS) ================= */

        /* A: Single tap/hold = A | Double tap/hold = LGUI */
        td_a: tap_dance_a {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&kp A>, <&hm_mod LGUI A>;
        };

        /* S: Single tap/hold = S | Double tap/hold = LALT */
        td_s: tap_dance_s {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&kp S>, <&hm_mod LALT S>;
        };

        /* D: Single tap/hold = D | Double tap/hold = LCTRL */
        td_d: tap_dance_d {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&kp D>, <&hm_mod LCTRL D>;
        };

        /* F: Single tap/hold = F | Double tap/hold = LSHFT */
        td_f: tap_dance_f {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&kp F>, <&hm_mod LSHFT F>;
        };

        /* ================= RIGHT HAND (SCAG) ================= */

        /* J: Single tap/hold = J | Double tap/hold = RSHFT */
        td_j: tap_dance_j {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&kp J>, <&hm_mod RSHFT J>;
        };

        /* K: Single tap/hold = K | Double tap/hold = RCTRL */
        td_k: tap_dance_k {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&kp K>, <&hm_mod RCTRL K>;
        };

        /* L: Single tap/hold = L | Double tap/hold = RALT */
        td_l: tap_dance_l {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&kp L>, <&hm_mod RALT L>;
        };

        /* SEMI: Single tap/hold = SEMI | Double tap/hold = RGUI */
        td_semi: tap_dance_semi {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS>;
            bindings = <&kp SEMI>, <&hm_mod RGUI SEMI>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp GRAVE   &kp N1     &kp N2        &kp N3        &kp N4    &kp N5       &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E         &kp R     &kp T        &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BSLH
&kp ESC     &td_a      &td_s         &td_d         &td_f     &kp G        &kp LEFT_ARROW   &kp H      &td_j      &td_k      &td_l            &td_semi    &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V     &kp B        &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp RSHFT
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &kp ENTER &mo 1        &kp ENTER        &none      &kp SPACE  &mo 2      &kp RCTRL        &kp DELETE
            >;
            sensor-bindings = <&scroll_encoder>;
           
            display-name = "AlphaNum";
        };

        layer_1 {
            bindings = <
&kp F1     &kp F2          &kp F3         &kp F4          &kp F5          &kp F6             &mmv MOVE_UP     &kp F7           &kp F8           &kp F9      &kp F10    &kp F11           &kp F12
&none      &none           &mkp LCLK      &mkp MCLK       &mkp RCLK       &mkp MB4           &mmv MOVE_DOWN   &kp PG_UP        &kp END          &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&none      &none           &none          &none           &none           &mkp MB5           &mmv MOVE_LEFT   &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&none      &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &none
&kp C_MUTE &trans          &trans         &trans          &trans          &none              &mkp LCLK        &trans           &none            &trans      &trans     &trans
            >;

            display-name = "MoveMouseMedia";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            
        };

        layer_2 {
            bindings = <
&none       &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4   &none     &rgb_ug RGB_ON   &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SPI   &rgb_ug RGB_SAI   &rgb_ug RGB_EFF
&none       &bt BT_CLR    &bt BT_CLR_ALL  &none         &none         &none          &none     &rgb_ug RGB_OFF  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SPD   &rgb_ug RGB_SAD   &rgb_ug RGB_EFR
&none       &out OUT_USB  &out OUT_BLE    &none         &none         &none          &none     &none            &none            &none            &none             &none             &none
&none       &sys_reset    &soft_off       &bootloader   &none         &none          &none     &none            &none            &sys_reset       &soft_off         &bootloader       &none
&kp C_MUTE  &trans        &trans          &trans        &trans        &none          &none     &none            &trans           &none            &trans            &trans
            >;

            display-name = "BoardControl";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            bindings = <
&none       &none   &none    &none   &none   &none    &none  &kp KP_NUM  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS  &none  &trans
&none       &none   &none    &none   &none   &none    &none  &kp KP_N7   &kp KP_N8     &kp KP_N9        &kp KP_PLUS   &none  &none
&none       &none   &none    &none   &none   &none    &none  &kp KP_N4   &kp KP_N5     &kp KP_N6        &kp KP_PLUS   &none  &none
&none       &none   &none    &none   &none   &none    &none  &kp KP_N1   &kp KP_N2     &kp KP_N3        &kp KP_ENTER  &none  &none
&kp C_MUTE  &trans  &trans   &trans  &trans  &none    &none  &kp KP_N0   &kp KP_N0     &kp KP_DOT       &kp KP_ENTER  &trans
            >;

            display-name = "10key";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};



