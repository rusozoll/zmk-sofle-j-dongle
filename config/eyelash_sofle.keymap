#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 35

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
}; /* Fixed: Added missing closing brace for first root block */

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <400>;
    acceleration-exponent = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";
        
        combo_toggle_hrm {
            timeout-ms = <50>;
            key-positions = <30 34 61>; 
            bindings = <&tog 1>;
        };
    };

    behaviors {
        /* Left Hand Home Row Mods */
        hm_left: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                 7  8  9 10 11 12
                20 21 22 23 24 25
                33 34 35 36 37 38
                46 47 48 49 50 51
                   53 54 55 56 57
            >;
            bindings = <&kp>, <&kp>;
        };

        /* Right Hand Home Row Mods */
        hm_right: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                 0  1  2  3  4  5
                13 14 15 16 17 18
                26 27 28 29 30 31
                39 40 41 42 43 44
                   52 53 54 55 56
            >;
            bindings = <&kp>, <&kp>;
        };

        /* Tap Dance for 10Key Layer Toggle */
        alt_td4: tap_dance_alt_layer4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings =
                <&kp LEFT_ALT>,  /* 1x tap or hold = Left Alt */
                <&tog 4>;        /* 2x tap = toggle Layer 4 */
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    macros {
        shift_MB3: shift_MB3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp MB3 &kp LEFT_SHIFT>;

            label = "SHIFT_MB3";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: Base Layer */
        layer0 {
            bindings = <
&kp GRAVE   &kp N1     &kp N2        &kp N3        &kp N4    &kp N5       &kp UP_ARROW     &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
&kp TAB     &kp Q      &kp W         &kp E         &kp R     &kp T        &kp DOWN_ARROW   &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BSLH
&kp ESC     &kp A      &kp S         &kp D         &kp F     &kp G        &kp LEFT_ARROW   &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp APOS
&kp LSHFT   &kp Z      &kp X         &kp C         &kp V     &kp B        &kp RIGHT_ARROW  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp RSHFT
&kp C_MUTE  &kp LCTRL  &kp LEFT_GUI  &alt_td4      &kp SPACE &mo 2        &kp ENTER        &kp ENTER  &kp SPACE  &mo 3      &kp RCTRL        &kp DELETE
            >;
            sensor-bindings = <&scroll_encoder>;
            display-name = "AlphaNum";
        };

        /* Layer 1: Bilateral Home Row Mods Overlay */
        layer_1 {
            bindings = <
&trans  &trans                &trans                &trans                &trans                &trans  &trans  &trans  &trans                &trans                &trans               &trans                 &trans
&trans  &trans                &trans                &trans                &trans                &trans  &trans  &trans  &trans                &trans                &trans               &trans                 &trans
&trans  &hm_left LGUI A       &hm_left LALT S       &hm_left LCTRL D      &hm_left LSHFT F      &trans  &trans  &trans  &hm_right RSHFT J     &hm_right RCTRL K     &hm_right RALT L     &hm_right RGUI SEMI    &trans
&trans  &trans                &trans                &trans                &trans                &trans  &trans  &trans  &trans                &trans                &trans               &trans                 &trans
&trans  &trans                &trans                &trans                &trans                &trans  &trans  &trans  &trans                &trans                &trans               &trans
            >;
            display-name = "BilateralHRM";
            sensor-bindings = <&scroll_encoder>;
        };

        /* Layer 2: MoveMouseMedia */
        layer_2 {
            bindings = <
&kp F1     &kp F2     &kp F3         &kp F4          &kp F5      &kp F6     &mmv MOVE_UP     &kp F7     &kp F8     &kp F9     &kp F10    &kp F11           &kp F12
&kp HOME   &kp END    &mkp LCLK      &mkp MCLK       &mkp RCLK   &mkp MB4   &mmv MOVE_DOWN   &none      &none      &kp UP     &none      &kp MINUS         &kp EQUAL
&kp PG_UP  &none      &kp C_VOL_DN   &kp C_MUTE      &kp C_VOL_UP &mkp MB5  &mmv MOVE_LEFT   &none      &kp LEFT   &kp DOWN   &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&kp PG_DN  &kp INSERT &kp C_PREV     &kp C_PLAY_PAUSE &kp C_NEXT  &none      &mmv MOVE_RIGHT  &none      &none      &none      &none      &none             &none
&kp C_MUTE &kp LCTRL  &kp LEFT_GUI   &alt_td4        &kp SPACE   &trans     &mkp LCLK        &kp ENTER  &kp SPACE  &mo 3      &kp RCTRL  &kp DELETE
            >;
            display-name = "MoveMouseMedia";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        /* Layer 3: BoardControl */
        layer_3 {
            bindings = <
&out OUT_BLE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none      &rgb_ug RGB_ON  &rgb_ug RGB_BRI &rgb_ug RGB_HUI &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_EFF
&out OUT_USB &none        &none        &none        &none        &none        &none      &rgb_ug RGB_OFF &rgb_ug RGB_BRD &rgb_ug RGB_HUD &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_EFR
&none        &none        &none        &none        &trans       &none        &none      &none           &trans          &none           &none           &none           &none
&bootloader  &none        &none        &none        &none        &none        &none      &none           &none           &none           &none           &none           &bootloader
&kp C_MUTE   &kp LCTRL    &kp LEFT_GUI &alt_td4     &kp SPACE    &mo 2        &bt BT_CLR &kp ENTER   &kp SPACE       &trans          &kp RCTRL       &kp DELETE
            >;
            display-name = "BoardControl";
            sensor-bindings = <&scroll_encoder>;
        };

        /* Layer 4: 10key */
        layer_4 {
            bindings = <
&none      &none     &none        &none        &none     &none &none &kp KP_NUM  &kp KP_SLASH  &kp KP_ASTERISK  &kp KP_MINUS  &none      &kp BACKSPACE
&none      &none     &none        &none        &none     &none &none &kp KP_N7   &kp KP_N8     &kp KP_N9        &kp KP_PLUS   &none      &kp BACKSPACE
&none      &none     &none        &none        &none     &none &none &kp KP_N4   &kp KP_N5     &kp KP_N6        &kp KP_PLUS   &none      &kp KP_ENTER
&none      &kp Z     &kp X        &kp C        &kp V     &none &none &kp KP_N1   &kp KP_N2     &kp KP_N3        &kp KP_ENTER  &none      &kp KP_ENTER 
&kp C_MUTE &kp LCTRL &kp LEFT_GUI &alt_td4     &kp SPACE &mo 2 &none &kp KP_N0   &kp KP_N0     &kp KP_DOT       &kp KP_ENTER  &kp KP_ENTER         
            >;
            display-name = "10key";
            sensor-bindings = <&scroll_encoder>;
        };
    };
}; /* Closing main root node */